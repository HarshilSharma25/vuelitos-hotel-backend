{
  "name": "hotel-backend",
  "version": "1.0.0",
  "description": "Vuelitos Hotels: Standalone Express 5 + TypeScript backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "local": "NODE_ENV=local tsx watch src/server.ts",
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "prod": "NODE_ENV=production tsx watch src/server.ts",
    "local:worker": "NODE_ENV=local tsx watch src/worker.ts",
    "dev:worker": "NODE_ENV=development tsx watch src/worker.ts",
    "prod:worker": "NODE_ENV=production tsx watch src/worker.ts",
    "start": "NODE_ENV=production node dist/src/server.js",
    "start:worker": "NODE_ENV=production node dist/src/worker.js",
    "test": "vitest run --fileParallelism=false",
    "test:unit": "vitest run test/unit",
    "test:int": "vitest run test/integration --fileParallelism=false",
    "scan:leak": "vitest run test/leak",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node --env-file=.env.local node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:local": "node --env-file=.env.local node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:dev": "node --env-file=.env.dev node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node --env-file=.env.prod node_modules/prisma/build/index.js migrate deploy",
    "prisma:deploy:local": "node --env-file=.env.local node_modules/prisma/build/index.js migrate deploy",
    "prisma:deploy:dev": "node --env-file=.env.dev node_modules/prisma/build/index.js migrate deploy",
    "seed": "NODE_ENV=local tsx prisma/seed.ts",
    "seed:dev": "NODE_ENV=development tsx prisma/seed.ts",
    "seed:prod": "NODE_ENV=production tsx prisma/seed.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs --only HotelBackend-Prod,HotelBackend-Worker-Prod --env production",
    "pm2:start:dev": "pm2 start ecosystem.config.cjs --only HotelBackend-Dev,HotelBackend-Worker-Dev --env development",
    "pm2:start:uat": "pm2 start ecosystem.config.cjs --only HotelBackend-UAT,HotelBackend-Worker-UAT --env uat",
    "pm2:start:local": "pm2 start ecosystem.config.cjs --only HotelBackend-Prod,HotelBackend-Worker-Prod --env local",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs HotelBackend-Prod",
    "pm2:logs:dev": "pm2 logs HotelBackend-Dev",
    "pm2:logs:uat": "pm2 logs HotelBackend-UAT",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.14",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "0.33.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.21.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "keywords": [],
  "author": "Harshil",
  "license": "ISC"
}
