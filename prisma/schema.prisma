datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BookingStatus {
  requested
  checking_availability
  awaiting_payment
  payment_submitted
  payment_verified
  confirmed
  alternatives_offered
  unavailable
  cancelled
  refund_pending
  refunded
}

enum PaymentMethod {
  stripe_card
  pago_movil
  bs_transfer
  zelle
  usdt_binance
  cash_usd
  cash_eur
}

enum Currency {
  USD
  EUR
}

enum AvailabilityMode {
  manual
  api
}

enum RateConcept {
  OCUPACION
  NINO
  PAX_ADICIONAL
}

enum PriceKind {
  IMPORTE
  BAJO_PEDIDO
  GRATIS
  PORCENTAJE_ADULTO
}

enum PricingUnit {
  per_room
  per_person
}

enum Role {
  agent
  admin
  super_admin
}

enum RateSource {
  auto
  manual
}

enum PaymentStatus {
  submitted
  verified
  rejected
  refunded
  pending
  needs_review
  expired
  failed
}

enum CheckStatus {
  pending
  available
  unavailable
  on_request
}

enum ImageStatus {
  held
  published
}

enum QuoteStatus {
  draft
  sent
  accepted
  declined
  expired
}

enum PaymentMode {
  online
  at_hotel
}

enum RefundRequestStatus {
  submitted
  in_review
  needs_info
  approved
  rejected
  completed
}

enum RefundReasonCode {
  change_of_plans
  found_better_option
  travel_cancelled
  medical
  duplicate_booking
  hotel_issue
  other
}

enum RefundDocumentKind {
  payment_proof
  booking_confirmation
  id_document
  other
  completion_proof
}

enum RefundDocumentSource {
  uploaded
  reused_receipt
  card_record
  system_confirmation
}

enum RefundDocumentUploadedBy {
  customer
  staff
}


model Hotel {
  id                      String                @id @default(uuid())
  slug                    String                @unique
  name                    String
  destination             String
  category                String
  starRating              Int?                  @map("star_rating")
  baseCurrency            Currency              @map("base_currency")
  isSoloDivisas           Boolean               @default(false) @map("is_solo_divisas")
  defaultCommissionPercent Decimal              @default(10.00) @map("default_commission_percent") @db.Decimal(5, 2)
  availabilityMode        AvailabilityMode      @default(manual) @map("availability_mode")
  isActive                Boolean               @default(true) @map("is_active")
  petsAllowed             Boolean               @default(false) @map("pets_allowed")
  childBandsEnabled       Boolean               @default(false) @map("child_bands_enabled")
  description             String?
  amenities               Json                  @default("[]")
  coverImageKey           String?               @map("cover_image_key")
  coverImageUrl           String?               @map("cover_image_url")
  payNowEnabled           Boolean?              @map("pay_now_enabled")
  payAtHotelEnabled       Boolean?              @map("pay_at_hotel_enabled")
  paymentWindowHours      Int?                  @map("payment_window_hours")
  reminderOffsetsPct      Json?                 @map("reminder_offsets_pct")
  autoConfirmAfterPayment Boolean?              @map("auto_confirm_after_payment")
  rooms                   RoomType[]
  seasons                 Season[]
  images                  HotelImage[]
  paymentRules            HotelPaymentTaxRule[]
  checks                  AvailabilityCheck[]

  @@index([destination, isActive])
  @@map("hotels")
}

model RoomType {
  id           String   @id @default(uuid())
  hotelId      String   @map("hotel_id")
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  name         String
  maxOccupancy Int      @map("max_occupancy")
  isActive     Boolean  @default(true) @map("is_active")
  rates        Rate[]

  @@map("room_types")
}

model Season {
  id          String    @id @default(uuid())
  hotelId     String    @map("hotel_id")
  hotel       Hotel     @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  name        String
  priority    Int
  dateFrom    DateTime  @map("date_from") @db.Date
  dateTo      DateTime  @map("date_to") @db.Date
  bookingFrom DateTime? @map("booking_from") @db.Date
  bookingTo   DateTime? @map("booking_to") @db.Date
  isActive    Boolean   @default(true) @map("is_active")
  rates       Rate[]

  @@map("seasons")
}

model Rate {
  id             String       @id @default(uuid())
  roomTypeId     String       @map("room_type_id")
  roomType       RoomType     @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  seasonId       String       @map("season_id")
  season         Season       @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  mealPlan       String       @map("meal_plan")
  concept        RateConcept?
  priceKind      PriceKind    @map("price_kind")
  occupancy      Int?
  pricingUnit    PricingUnit  @map("pricing_unit")
  netRate        Decimal      @map("net_rate") @db.Decimal(12, 2)
  markupPercent  Decimal?     @map("markup_percent") @db.Decimal(5, 2)
  sellRate       Decimal?     @map("sell_rate") @db.Decimal(12, 2)
  percentOfAdult Decimal?     @map("percent_of_adult") @db.Decimal(5, 2)
  childAgeMin    Int?         @map("child_age_min")
  childAgeMax    Int?         @map("child_age_max")
  daysOfWeek     Int[]        @map("days_of_week")
  minNights      Int          @default(1) @map("min_nights")
  maxNights      Int?         @map("max_nights")
  packageNights  Int?         @map("package_nights")
  sourcePage     Int?         @map("source_page")
  isActive       Boolean      @default(true) @map("is_active")

  @@map("rates")
}

model ExchangeRate {
  id               BigInt      @id @default(autoincrement())
  bcvUsd           Decimal     @map("bcv_usd") @db.Decimal(12, 4)
  bcvEur           Decimal     @map("bcv_eur") @db.Decimal(12, 4)
  binanceUsdt      Decimal     @map("binance_usdt") @db.Decimal(12, 4)
  bcvUsdSource     String      @map("bcv_usd_source")
  bcvEurSource     String      @map("bcv_eur_source")
  usdtSource       String      @map("usdt_source")
  recordedAt       DateTime    @default(now()) @map("recorded_at")
  fetchedAt        DateTime    @default(now()) @map("fetched_at")
  bcvValueDate     DateTime    @map("bcv_value_date") @db.Date
  source           RateSource  @default(auto)
  isManualOverride Boolean     @default(false) @map("is_manual_override")

  @@index([recordedAt])
  @@map("exchange_rates")
}

model BcvPublishedRate {
  valueDate   DateTime @id @map("value_date") @db.Date
  usd         Decimal  @db.Decimal(12, 4)
  eur         Decimal  @db.Decimal(12, 4)
  publishedAt DateTime @map("published_at")

  @@map("bcv_published_rates")
}

model HotelPaymentTaxRule {
  hotelId          String        @map("hotel_id")
  hotel            Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  method           PaymentMethod
  ivaRate          Decimal       @map("iva_rate") @db.Decimal(5, 4)
  surchargePercent Decimal?      @map("surcharge_percent") @db.Decimal(5, 2)

  @@id([hotelId, method])
  @@map("hotel_payment_tax_rules")
}

model Booking {
  id                String         @id @default(uuid())
  code              String         @unique
  status            BookingStatus  @default(requested)
  userId            String?        @map("user_id")
  accessKey         String         @map("access_key") @db.Uuid
  locale            String         @default("es")
  contactName       String         @map("contact_name")
  contactEmail      String         @map("contact_email")
  contactPhone      String?        @map("contact_phone")
  notes             String?
  guestDetails      Json?          @map("guest_details")
  paymentMethodPref PaymentMethod? @map("payment_method_pref")
  termsAcceptedAt   DateTime       @map("terms_accepted_at")
  totalsByMethod    Json           @map("totals_by_method")
  fxSnapshot        Json           @map("fx_snapshot")
  slaDueAt          DateTime?      @map("sla_due_at")
  paymentMode       PaymentMode    @default(online) @map("payment_mode")
  paymentWindowHours Int?          @map("payment_window_hours")
  remindersSent     Int[]          @default([]) @map("reminders_sent")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  items             BookingItem[]
  events            BookingEvent[]
  payments          Payment[]
  checks            AvailabilityCheck[]
  refundRequests    RefundRequest[]
  refundStagedUploads RefundStagedUpload[]

  @@index([userId])
  @@map("bookings")
}

model RefundRequest {
  id                      String               @id @default(uuid())
  bookingId               String               @map("booking_id")
  booking                 Booking              @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  status                  RefundRequestStatus  @default(submitted)
  publicReference         String?              @unique @map("public_reference")
  reasonCode              RefundReasonCode     @map("reason_code")
  reasonText              String?              @map("reason_text") @db.VarChar(1000)
  requestedBy             String               @map("requested_by")
  destinationMethod       String               @map("destination_method")
  destinationDetailsEnc   String               @map("destination_details_enc") @db.Text
  approvedAmount          Decimal?             @map("approved_amount") @db.Decimal(12, 2)
  approvedCurrency        String?              @map("approved_currency")
  staffMessage            String?              @map("staff_message") @db.VarChar(2000)
  rejectionReason         String?              @map("rejection_reason") @db.VarChar(2000)
  refundReference         String?              @map("refund_reference")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  documents               RefundDocument[]
  events                  RefundEvent[]

  @@index([bookingId])
  @@index([status, createdAt])
  @@map("refund_requests")
}

model RefundDocument {
  id              String                   @id @default(uuid())
  refundRequestId String                   @map("refund_request_id")
  refundRequest   RefundRequest            @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  kind            RefundDocumentKind
  source          RefundDocumentSource     @default(uploaded)
  storageKey      String                   @map("storage_key")
  linkedPaymentId String?                  @map("linked_payment_id")
  contentHash     String?                  @map("content_hash")
  originalName    String                   @map("original_name")
  mimeType        String                   @map("mime_type")
  sizeBytes       Int                      @map("size_bytes")
  uploadedBy      RefundDocumentUploadedBy @map("uploaded_by")
  createdAt       DateTime                 @default(now()) @map("created_at")

  @@index([refundRequestId])
  @@index([contentHash])
  @@map("refund_documents")
}

model RefundStagedUpload {
  id           String    @id @default(uuid())
  bookingId    String    @map("booking_id")
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  uploaderKey  String    @map("uploader_key")
  storageKey   String    @map("storage_key")
  contentHash  String    @map("content_hash")
  originalName String    @map("original_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([bookingId, uploaderKey])
  @@index([expiresAt])
  @@map("refund_staged_uploads")
}

model RefundIdempotencyKey {
  id           String   @id @default(uuid())
  bookingId    String   @map("booking_id")
  key          String
  responseJson Json     @map("response_json")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@unique([bookingId, key])
  @@index([expiresAt])
  @@map("refund_idempotency_keys")
}

model RefundEvent {
  id              BigInt               @id @default(autoincrement())
  refundRequestId String               @map("refund_request_id")
  refundRequest   RefundRequest        @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  fromStatus      RefundRequestStatus? @map("from_status")
  toStatus        RefundRequestStatus  @map("to_status")
  actorType       String               @map("actor_type")
  actorId         String?              @map("actor_id")
  note            String?
  createdAt       DateTime             @default(now()) @map("created_at")

  @@map("refund_events")
}

model BookingItem {
  id             String   @id @default(uuid())
  bookingId      String   @map("booking_id")
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  type           String   @default("hotel_stay")
  hotelId        String   @map("hotel_id")
  checkIn        DateTime @map("check_in") @db.Date
  checkOut       DateTime @map("check_out") @db.Date
  mealPlan       String   @map("meal_plan")
  roomSelections Json     @map("room_selections")
  priceSnapshot  Json     @map("price_snapshot")

  @@map("booking_items")
}

model BookingEvent {
  id         BigInt         @id @default(autoincrement())
  bookingId  String         @map("booking_id")
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  event      String
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  actorType  String         @map("actor_type")
  actorId    String?        @map("actor_id")
  note       String?
  createdAt  DateTime       @default(now()) @map("created_at")

  @@map("booking_events")
}

model Payment {
  id                 String        @id @default(uuid())
  bookingId          String        @map("booking_id")
  booking            Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  method             PaymentMethod
  currency           String
  amountQuoted       Decimal       @map("amount_quoted") @db.Decimal(12, 2)
  amountReceived     Decimal?      @map("amount_received") @db.Decimal(12, 2)
  reference          String
  status             PaymentStatus @default(submitted)
  rejectionReason    String?       @map("rejection_reason")
  rejectionNotes     String?       @map("rejection_notes")
  submittedAt        DateTime      @default(now()) @map("submitted_at")
  verifiedAt         DateTime?     @map("verified_at")
  verifiedBy         String?       @map("verified_by")
  externalProvider   String?       @map("external_provider")
  externalSessionId  String?       @unique @map("external_session_id")
  rawStatus          String?       @map("raw_status")
  proofStorageKey    String?       @map("proof_storage_key")
  proofContentHash   String?       @map("proof_content_hash")
  proofMimeType      String?       @map("proof_mime_type")
  proofOriginalName  String?       @map("proof_original_name")

  @@map("payments")
}

model PaymentEvent {
  id        BigInt   @id @default(autoincrement())
  provider  String
  eventId   String   @map("event_id")
  type      String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("payment_events")
}

model AvailabilityCheck {
  id        String      @id @default(uuid())
  bookingId String?     @map("booking_id")
  booking   Booking?    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  hotelId   String      @map("hotel_id")
  hotel     Hotel       @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  checkIn   DateTime    @map("check_in") @db.Date
  checkOut  DateTime    @map("check_out") @db.Date
  status    CheckStatus @default(pending)
  checkedBy String?     @map("checked_by")
  checkedAt DateTime?   @map("checked_at")
  note      String?

  @@map("availability_checks")
}

model HotelImage {
  id         String      @id @default(uuid())
  hotelId    String      @map("hotel_id")
  hotel      Hotel       @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  key        String
  sourceUrl  String?     @map("source_url")
  sourceKind String?     @map("source_kind")
  status     ImageStatus @default(held)
  sortOrder  Int         @default(0) @map("sort_order")
  alt        String?

  @@map("hotel_images")
}

model Quote {
  id                String      @id @default(uuid())
  code              String      @unique
  tokenKey          String      @map("token_key") @db.Uuid
  status            QuoteStatus @default(draft)
  lines             Json
  commissionPercent Decimal     @map("commission_percent") @db.Decimal(5, 2)
  commissionAmount  Decimal     @map("commission_amount") @db.Decimal(12, 2)
  internalNotes     String?     @map("internal_notes")
  expiresAt         DateTime    @map("expires_at")

  @@map("quotes")
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("leads")
}

model StaffUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(agent)
  sessions     Session[]

  @@map("staff_users")
}

model Session {
  id         String    @id @default(uuid())
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id")
  user       StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  userAgent  String?   @map("user_agent")

  @@map("sessions")
}

model Holiday {
  date DateTime @id @db.Date
  name String

  @@map("holidays")
}

model CheckoutSettings {
  id                      String   @id @default("global")
  payNowEnabled           Boolean  @default(true) @map("pay_now_enabled")
  payAtHotelEnabled       Boolean  @default(true) @map("pay_at_hotel_enabled")
  cardPaymentsEnabled     Boolean  @default(true) @map("card_payments_enabled")
  paymentWindowHours      Int      @default(48) @map("payment_window_hours")
  reminderOffsetsPct      Int[]    @default([50, 90]) @map("reminder_offsets_pct")
  autoConfirmAfterPayment Boolean  @default(false) @map("auto_confirm_after_payment")
  refundReviewSlaHours    Int      @default(48) @map("refund_review_sla_hours")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("checkout_settings")
}

model SettingsAudit {
  id          String   @id @default(uuid())
  settingType String   @map("setting_type")
  targetId    String?  @map("target_id")
  oldValue    Json     @map("old_value")
  newValue    Json     @map("new_value")
  actorId     String   @map("actor_id")
  actorType   String   @map("actor_type")
  timestamp   DateTime @default(now())

  @@index([settingType, targetId])
  @@map("settings_audit")
}

