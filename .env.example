# ==============================================================================
# Hotel Backend - Environment Configuration Example
# Copy to .env.local, .env.dev, .env.prod, or .env.uat
# npm run local -> .env.local | npm run dev -> .env.dev | npm run prod -> .env.prod
# ==============================================================================

PORT=3001
NODE_ENV=local

# Database (MySQL)
DATABASE_URL=mysql://root:password@127.0.0.1:3306/hotel_backend

# Redis
REDIS_URL=redis://localhost:6379

# Session Secret (Must be 32+ characters)
SESSION_SECRET=dev-session-secret-must-be-at-least-32-chars-long!

# Gateway Origins
PUBLIC_API_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174

# Booking & Group SLA Configuration
PAYMENT_WINDOW_HOURS=48
GROUP_MIN_ROOMS=5
GROUP_MIN_GUESTS=12

# Internal Flight Backend Channel (Inter-service)
FLIGHT_INTERNAL_URL=http://127.0.0.1:8081
INTERNAL_SERVICE_SECRET=vuelitos-internal-secret-key-32chars-minimum-prod!

# Card & Return URLs
CARD_RETURN_URL_BASE=http://localhost:5174/booking/payment-status
FRONTEND_URL=http://localhost:5174
WEBSITE_URL=http://localhost:5174

# Reverse Proxy Security
TRUST_PROXY=1
TRUST_CF_CONNECTING_IP=false
METRICS_TOKEN=

# Pricing Flags
PRICING_CHILD_BANDS=false

# Media & File Upload Storage
FILES_DRIVER=local
FILES_ROOT=./uploads
FILES_PUBLIC_BASE_URL=http://localhost:3000/files
PRIVATE_FILES_DIR=./private-uploads

# Customer Bank Data Encryption Key (Must be 32+ characters)
REFUND_DATA_KEY=dev-refund-data-key-must-be-32-chars-min!!

# Shared Authentication with Flight-Booking-Backend
# In production, set to: travelCaribProdSecretKey
# In local dev, set to: travelCaribLocalSecretKey
JWT_SECRET=travelCaribLocalSecretKey
JWT_ISSUER=vuelitos-auth
JWT_AUDIENCE=vuelitos-platform
JWT_ALGORITHM=auto
