# ==============================================================================
# Hotel Backend - Production Environment Configuration
# Deployed to VPS (behind Caddy unified gateway at https://api.flight.softnear.xyz)
# ==============================================================================

PORT=3000
NODE_ENV=production

# Database (MySQL) — same prod user as ../server, hotel database
DATABASE_URL="mysql://vuelitos:StayConnected123!@127.0.0.1:3306/hotels"

# Redis (Session & Job Queue)
REDIS_URL=redis://127.0.0.1:6379

# Session Secret (Minimum 32 characters)
SESSION_SECRET=vuelitos-hotel-prod-session-secret-must-be-32-chars-long!

# Gateway Origins & Public Access
PUBLIC_API_ORIGIN=https://api.flight.softnear.xyz/hotel
ALLOWED_ORIGINS=https://www.vuelitos.com,https://vuelitos.com,https://admin.vuelitos.com,https://api.flight.softnear.xyz,https://api.vuelitos.com,https://uat-website.softnear.xyz/

# Booking & Group SLA Configuration
PAYMENT_WINDOW_HOURS=48
GROUP_MIN_ROOMS=5
GROUP_MIN_GUESTS=12

# Internal Flight Backend Channel (Inter-service on VPS)
FLIGHT_INTERNAL_URL=http://127.0.0.1:8081
INTERNAL_SERVICE_SECRET=vuelitos-internal-secret-key-32chars-minimum-prod!

# Card & Return URLs
CARD_RETURN_URL_BASE=https://www.vuelitos.com/booking/payment-status
FRONTEND_URL=https://www.vuelitos.com
WEBSITE_URL=https://www.vuelitos.com

# Reverse Proxy Security
TRUST_PROXY=1
TRUST_CF_CONNECTING_IP=false
METRICS_TOKEN=

# Pricing Flags
PRICING_CHILD_BANDS=false

# Media & File Upload Storage
FILES_DRIVER=local
FILES_ROOT=/var/www/html/uploads
FILES_PUBLIC_BASE_URL=https://api.flight.softnear.xyz/hotel/files
PRIVATE_FILES_DIR=./private-uploads

# Customer Bank Data Encryption Key (Minimum 32 characters)
REFUND_DATA_KEY=vuelitos-prod-refund-key-32-chars-minimum!!

# Shared Authentication with Flight-Booking-Backend (Must match JWT_SECRET in Flight-Booking-Backend/.env.prod)
JWT_SECRET=travelCaribProdSecretKey
JWT_ISSUER=vuelitos-auth
JWT_AUDIENCE=vuelitos-platform
JWT_ALGORITHM=auto
