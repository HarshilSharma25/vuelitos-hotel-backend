# ==============================================================================
# Hotel Backend - UAT environment (npm run pm2:start:uat)
# ==============================================================================

PORT=3002
NODE_ENV=uat

# Database (MySQL) — same UAT user as ../server, hotel database
DATABASE_URL="mysql://flightDev:FlightDevUser%26123@127.0.0.1:3306/hotelUat"

# Redis (Session & Job Queue)
REDIS_URL=redis://127.0.0.1:6379

# Session Secret (Minimum 32 characters)
SESSION_SECRET=vuelitos-hotel-uat-session-secret-must-be-32-chars-long!

# Gateway Origins & Public Access
PUBLIC_API_ORIGIN=http://127.0.0.1:3002
ALLOWED_ORIGINS=https://uat-website.softnear.xyz,https://uat.flight-admin.softnear.xyz,http://localhost:5173,http://localhost:5174

# Booking & Group SLA Configuration
PAYMENT_WINDOW_HOURS=48
GROUP_MIN_ROOMS=5
GROUP_MIN_GUESTS=12

# Internal Flight Backend Channel
FLIGHT_INTERNAL_URL=http://127.0.0.1:8081
INTERNAL_SERVICE_SECRET=vuelitos-internal-secret-key-32chars-minimum-prod!

# Card & Return URLs
CARD_RETURN_URL_BASE=https://uat-website.softnear.xyz/booking/payment-status
FRONTEND_URL=https://uat-website.softnear.xyz
WEBSITE_URL=https://uat-website.softnear.xyz

# Reverse Proxy Security
TRUST_PROXY=1
TRUST_CF_CONNECTING_IP=false
METRICS_TOKEN=

# Pricing Flags
PRICING_CHILD_BANDS=false

# Media & File Upload Storage
FILES_DRIVER=local
FILES_ROOT=./uploads
FILES_PUBLIC_BASE_URL=http://127.0.0.1:3002/files
PRIVATE_FILES_DIR=./private-uploads

# Customer Bank Data Encryption Key (Minimum 32 characters)
REFUND_DATA_KEY=vuelitos-uat-refund-key-32-chars-minimum!!

# Shared Authentication with Flight-Booking-Backend
JWT_SECRET=travelCaribProdSecretKey
JWT_ISSUER=vuelitos-auth
JWT_AUDIENCE=vuelitos-platform
JWT_ALGORITHM=auto
